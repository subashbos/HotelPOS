<UserControl x:Class="HotelPOS.Views.EstimationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1100" d:DesignWidth="1400">

    <UserControl.Resources>
        <!-- Field Styles matching existing Views (same as PurchaseEntryView) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>

        <Style x:Key="InputField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin"          Value="0,0,0,16"/>
        </Style>

        <Style x:Key="GridTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>

        <Style x:Key="GridComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>

        <Style x:Key="CalculatedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,14,0"/>
            <Setter Property="Background" Value="#1F00A896"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="DeleteRowBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Remove row"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="32" Height="32" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FC0392B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small action button used in the Existing Estimations grid -->
        <Style x:Key="RowActionBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Scrollable content -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Background="{DynamicResource HeaderBrush}" Padding="32,20">
            <StackPanel>
                <TextBlock Text="📝  Estimations" Style="{StaticResource HeroTextBlockStyle}" Foreground="White"/>
                <TextBlock Text="Create customer quotations/cost estimates and convert accepted ones into real orders."
                           Margin="0,4,0,0" Style="{StaticResource BodySmallTextBlockStyle}" Foreground="White" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- ══ ENTRY FORM (30/70 SPLIT) ══ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>  <!-- Left Form (30%) -->
                        <ColumnDefinition Width="7*"/>  <!-- Right Grid/Summary (70%) -->
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT FORM SIDEBAR ── -->
                    <Border Grid.Column="0" Margin="0,0,16,0" Style="{StaticResource PremiumCard}">
                        <StackPanel Margin="0,4,0,4">
                            <TextBlock Text="ESTIMATION HEADER" Style="{StaticResource H3TextBlockStyle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Estimation Number *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EstimationNumberTextBox" Text="{Binding EstimationNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/>

                            <TextBlock Text="Estimation Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding EstimationDate}" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                            <TextBlock Text="Valid Until (Optional)" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding ValidUntil}" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                            <TextBlock Text="Customer (Optional)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Height="40"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,0,16"/>

                            <TextBlock Text="Notes (Optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="12,8"
                                     Style="{StaticResource InputField}"/>
                        </StackPanel>
                    </Border>

                    <!-- ── RIGHT: ITEMS GRID + SUMMARY ── -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <Border Style="{StaticResource PremiumCard}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>  <!-- Toolbar -->
                                    <RowDefinition Height="Auto"/>  <!-- DataGrid -->
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Estimation Items" Style="{StaticResource H3TextBlockStyle}" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Select items from catalog, specify details and observe real-time row totals." Style="{StaticResource BodySmallTextBlockStyle}" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="➕  Add Row"
                                            Command="{Binding AddRowCommand}"
                                            Style="{StaticResource PrimaryBtn}" Padding="16,8"/>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding EstimationRows}"
                                          Style="{StaticResource PremiumGrid}"
                                          SelectionMode="Single"
                                          SelectionUnit="CellOrRowHeader"
                                          RowHeight="48"
                                          Height="280"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="S.NO" Binding="{Binding SNo}" IsReadOnly="True" Width="55" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterCell}"/>

                                        <DataGridTemplateColumn Header="ITEM NAME" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.CatalogItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedValue="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="Name"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="True"
                                                              Style="{StaticResource GridComboBox}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="QTY" Width="85" HeaderStyle="{StaticResource CenterHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource GridTextBox}"
                                                             HorizontalContentAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="UOM" Binding="{Binding Unit}" IsReadOnly="True" Width="60" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterCell}"/>

                                        <DataGridTemplateColumn Header="UNIT PRICE" Width="110" HeaderStyle="{StaticResource RightHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                             Style="{StaticResource GridTextBox}"
                                                             HorizontalContentAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="TAX (%)" Width="90" HeaderStyle="{StaticResource CenterHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding TaxPercentage, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                             Style="{StaticResource GridTextBox}"
                                                             HorizontalContentAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="DISCOUNT" Width="100" HeaderStyle="{StaticResource RightHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                             Style="{StaticResource GridTextBox}"
                                                             HorizontalContentAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=N2}" IsReadOnly="True" Width="110" HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource CalculatedCell}"/>

                                        <DataGridTemplateColumn Width="60" HeaderStyle="{StaticResource CenterHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️"
                                                            Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DeleteRowBtn}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- ── SUMMARY & ACTIONS ── -->
                        <Border Background="{DynamicResource HeaderBrush}" CornerRadius="12" Padding="20,16" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SUBTOTAL" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.65"/>
                                    <TextBlock Text="{Binding Subtotal, StringFormat=₹{0:N2}}" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TOTAL TAX" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.65"/>
                                    <TextBlock Text="{Binding TotalTax, StringFormat=₹{0:N2}}" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TOTAL DISCOUNT" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.65"/>
                                    <TextBlock Text="{Binding TotalDiscount, StringFormat=₹{0:N2}}" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="3" Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="GRAND TOTAL: " FontSize="12" FontWeight="Bold" Foreground="White" Opacity="0.85" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GrandTotal, StringFormat=₹{0:N2}}" FontSize="20" FontWeight="Black" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="❌  Cancel &amp; Reset"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource SecondaryBtn}"
                                    Padding="24,12" FontSize="14" Margin="0,0,24,0"/>

                            <Button Command="{Binding SaveEstimationCommand}"
                                    Style="{StaticResource PrimaryBtn}" Content="💾  Save Estimation" Padding="32,12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ══ EXISTING ESTIMATIONS ══ -->
                <Border Style="{StaticResource PremiumCard}" Padding="20" Margin="0,24,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Existing Estimations" Style="{StaticResource H3TextBlockStyle}" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Move an estimation through Sent / Accepted / Rejected, then convert an Accepted one into a real order." Style="{StaticResource BodySmallTextBlockStyle}" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🔄  Refresh"
                                    Command="{Binding RefreshEstimationsCommand}"
                                    Style="{StaticResource SecondaryBtn}" Padding="16,8"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Estimations}"
                                  Style="{StaticResource PremiumGrid}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  IsReadOnly="True"
                                  RowHeight="48"
                                  Height="360"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ESTIMATION #" Binding="{Binding EstimationNumber}" Width="130"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding EstimationDate, StringFormat=d}" Width="90" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="150"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="GRAND TOTAL" Binding="{Binding GrandTotal, StringFormat=N2}" Width="110" HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource CalculatedCell}"/>

                                <DataGridTemplateColumn Header="ACTIONS" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Button Content="Mark Sent" Style="{StaticResource RowActionBtn}"
                                                        Command="{Binding DataContext.MarkAsSentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Accept" Style="{StaticResource RowActionBtn}"
                                                        Command="{Binding DataContext.MarkAsAcceptedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Reject" Style="{StaticResource RowActionBtn}"
                                                        Command="{Binding DataContext.MarkAsRejectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Convert to Order" Style="{StaticResource RowActionBtn}"
                                                        Command="{Binding DataContext.ConvertToOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
