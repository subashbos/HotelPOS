<UserControl x:Class="HotelPOS.Views.TdsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1150">

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER BANNER ══ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" Padding="32,20">
            <StackPanel>
                <TextBlock Text="🏛️  TDS &amp; Tax Structure Setup" Style="{StaticResource HeroTextBlockStyle}" Foreground="White"/>
                <TextBlock Text="Configure new-regime Tax Deducted at Source (TDS) parameters, exemption limits, and income slab rates."
                           Margin="0,4,0,0" Style="{StaticResource BodySmallTextBlockStyle}" Foreground="White" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT: GENERAL PARAMS & ACTIONS ══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="FINANCIAL YEAR" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="Select Financial Year Start" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding FinancialYears}" SelectedItem="{Binding SelectedYear}" 
                                      Margin="0,0,0,16"/>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,4,0,16"/>

                            <TextBlock Text="TAX REGIME CONFIGURATION" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="Standard Deduction (₹)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding StandardDeduction, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <TextBlock Text="Sec 87A Rebate Income Limit (₹)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RebateIncomeLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <TextBlock Text="Health &amp; Education Cess Rate (%)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CessRatePercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                            <Button Content="💾 Save TDS Configuration" Command="{Binding SaveCommand}" IsDefault="True"
                                    Style="{StaticResource PrimaryBtn}" Margin="0,0,0,10"/>

                            <Button Content="🗑️ Delete Year Config" Command="{Binding DeleteCommand}"
                                    Style="{StaticResource DangerBtn}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ RIGHT: INCOME SLAB BANDS ══ -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="INCOME SLAB BANDS" Style="{StaticResource FieldLabel}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="➕ Add Slab Band" Command="{Binding AddSlabCommand}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                            <Button Content="➖ Remove Selected" Command="{Binding RemoveSlabCommand}" Style="{StaticResource DangerBtn}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Slabs}" SelectedItem="{Binding SelectedSlab}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent"
                              BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding DisplayOrder}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Income From (₹)" Binding="{Binding IncomeFrom, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="Income To (₹)" Binding="{Binding IncomeTo, TargetNullValue='No Upper Limit', StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="Tax Rate (%)" Binding="{Binding RatePercent, StringFormat={}{0:N1}%}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="* Slabs are evaluated in order of DisplayOrder. The final slab must have no upper bound (Income To = empty)."
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
