{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "angular-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--prefix", "src/HotelPOS.Client"],
      "port": 4200
    },
    {
      "name": "api",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:HOTELPOS_PII_KEY = [Environment]::GetEnvironmentVariable('HOTELPOS_PII_KEY','User'); dotnet run --project src/API/HotelPOS.Api.csproj"],
      "port": 55982
    }
  ]
}
